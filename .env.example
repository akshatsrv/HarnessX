# ==============================================================================
# ClaimGuard AI - Environment Variables
# ==============================================================================

# Application Configuration
APP_ENV=development
DEBUG=True
PORT=8080
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Cloud Project Details
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Firebase Configuration
FIREBASE_PROJECT_ID=your-gcp-project-id
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# Google Cloud Storage
GCS_BUCKET_CLAIMS=claimguard-claims-documents
GCS_SIGNED_URL_EXPIRY_MINUTES=15

# Google Document AI
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=your-processor-id

# BigQuery Analytics
BIGQUERY_DATASET=claimguard_demo
BIGQUERY_CLAIMS_TABLE=claims
BIGQUERY_CUSTOMERS_TABLE=customers
BIGQUERY_VEHICLES_TABLE=vehicles
BIGQUERY_REPAIR_ESTIMATES_TABLE=repair_estimates

# Vertex AI & Gemini Configuration
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL_ID=gemini-1.5-pro
GEMINI_TEMPERATURE=0.2

# Vertex AI Search / Policy Retrieval
VERTEX_SEARCH_DATA_STORE_ID=insurance-policies-store
